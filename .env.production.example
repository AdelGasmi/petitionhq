# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://petitionhq.us
SESSION_SECRET=<generate: openssl rand -base64 32>
SESSION_TTL_DAYS=7
DOMAIN=petitionhq.us

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=petition
POSTGRES_PASSWORD=<strong random password>
POSTGRES_DB=petition
# DATABASE_URL is composed by docker-compose, not set manually

# ── Storage — Cloudflare R2 (dual-bucket) ────────────────────────────────────
# Two separate buckets by sensitivity level:
#   SECURE — private user data (CVs, intake forms, evidence). Always signed URLs.
#   PUBLIC — static assets, logos. Served via assets.petitionhq.us CDN.
STORAGE_BACKEND=r2
R2_ENDPOINT=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET_SECURE=petitionhq-secure-data
R2_BUCKET_PUBLIC=petitionhq-public-assets
R2_ACCESS_KEY_ID=<R2 API token access key>
R2_SECRET_ACCESS_KEY=<R2 API token secret>
R2_PUBLIC_URL=https://assets.petitionhq.us

# ── Email — Resend ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=<resend API key>
SMTP_FROM=PetitionHQ <hello@petitionhq.us>

# ── Admin alert destination ──────────────────────────────────────────────────
ADMIN_EMAIL=admin@petitionhq.us

# ── Stripe (Pricing-V2) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...           # fill after creating webhook endpoint in Stripe dashboard
STRIPE_PRICE_CASE_NIW=price_...           # one-time, $150 per case
STRIPE_PRICE_CASE_MGMT_SEAT=price_...     # recurring monthly, $100 / attorney

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# claude-sonnet-4-6 → drafting | claude-haiku-4-5-20251001 → fast/grounding

# ── Cron ─────────────────────────────────────────────────────────────────────
CRON_SECRET=<generate: openssl rand -hex 32>

# ── Twilio SMS (post-launch, optional) ───────────────────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
