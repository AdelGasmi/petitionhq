# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000
SESSION_SECRET=dev-secret-change-in-production  # Generate for prod: openssl rand -base64 32
SESSION_TTL_DAYS=7

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://petition:petition_dev@localhost:5433/petition

# ── Storage ───────────────────────────────────────────────────────────────────
# STORAGE_BACKEND=local    # default — writes to data/storage/ on disk
# STORAGE_BACKEND=r2       # production — set R2_* vars below
# STORAGE_LOCAL_PATH=      # override local storage root (default: data/storage)
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=petition-uploads
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=           # optional: skip signing if bucket is public

# ── LLM ──────────────────────────────────────────────────────────────────────
# LLM_PROVIDER=lmstudio    # default for local dev
# LLM_PROVIDER=anthropic   # production — set ANTHROPIC_API_KEY
# LLM_PROVIDER=openrouter  # alternative cloud
LMSTUDIO_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=
LMSTUDIO_MODEL_FAST=
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=

# ── Email — Mailhog for local dev, Resend for prod ────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@localhost
# Prod (Resend):
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=<resend API key>
# SMTP_FROM=PetitionHQ <hello@petitionhq.us>

# ── Admin alert destination ──────────────────────────────────────────────────
ADMIN_EMAIL=admin@petitionhq.us

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Pricing-V2 — create products in Stripe Dashboard, paste their price IDs:
STRIPE_PRICE_CASE_NIW=price_...         # one-time, $150 per case
STRIPE_PRICE_CASE_MGMT_SEAT=price_...   # recurring monthly, $100 / attorney

# ── Cloudflare Turnstile (CAPTCHA) ───────────────────────────────────────────
# Get keys at https://dash.cloudflare.com → Turnstile
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x...
# TURNSTILE_SECRET_KEY=0x...

# ── Rate Limiting (Upstash Redis) ────────────────────────────────────────────
# Optional — rate limiting is disabled if not set (fail-open).
# Create a free Redis database at https://console.upstash.com
# UPSTASH_REDIS_REST_URL=https://...upstash.io
# UPSTASH_REDIS_REST_TOKEN=AX...

# ── Cron ─────────────────────────────────────────────────────────────────────
CRON_SECRET=                # leave blank to disable auth in dev

# ── ORCID OAuth — "Sign in with ORCID" identity verification boost ───────────
# Register a public-API OAuth app at https://orcid.org/developer-tools
# Sandbox (dev): https://sandbox.orcid.org/developer-tools
# ORCID_CLIENT_ID=APP-...
# ORCID_CLIENT_SECRET=...
# ORCID_REDIRECT_URI=https://petitionhq.us/api/auth/orcid/callback
# ORCID_ENV=production         # set to "sandbox" for dev/staging

# ── Field-level PII encryption (S-12) ────────────────────────────────────────
# AES-256-GCM encryption for SSN / A-number / passport fields in Case.formData.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in production; optional in dev (encryption is skipped when unset).
# FIELD_ENCRYPTION_KEY=<32-byte value, base64-encoded>
# Key rotation: set FIELD_ENCRYPTION_KEY_PREV to the old key value; new writes
# use the current key while old rows decrypt transparently until re-written.
# FIELD_ENCRYPTION_KEY_PREV=

# ── Twilio SMS (optional) ─────────────────────────────────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
