{
  "name": "petitionhq",
  "version": "1.0.0",
  "description": "The smartest way to build your U.S. immigration petition. Free case assessment and AI-powered brief drafting for immigration attorneys.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "bash scripts/check-raw-colors.sh && npx tsx scripts/check-contrast.ts && next lint",
    "check:colors": "bash scripts/check-raw-colors.sh",
    "check:contrast": "npx tsx scripts/check-contrast.ts",
    "check:freshness": "npx tsx scripts/check-freshness.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate-test": "DATABASE_URL=${TEST_DATABASE_URL:-postgresql://petition:petition_dev@localhost:5433/petition} npx prisma migrate deploy",
    "pretest": "npm run db:migrate-test 2>/dev/null || true",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.74",
    "@ai-sdk/openai": "^3.0.58",
    "@aws-sdk/client-s3": "^3.1041.0",
    "@aws-sdk/s3-request-presigner": "^3.1041.0",
    "@prisma/client": "^5.22.0",
    "@react-pdf/renderer": "^4.5.1",
    "@types/pg": "^8.20.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "ai": "^6.0.174",
    "bcryptjs": "^3.0.3",
    "docx": "^9.6.1",
    "jose": "^6.2.2",
    "next": "^15.1.6",
    "nodemailer": "^8.0.6",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^22.1.0",
    "twilio": "^6.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^4.1.5"
  }
}
